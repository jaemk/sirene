---
source: crates/sirene-core/tests/railroad.rs
expression: "railroad-ebnf-beta\ntitle \"Arithmetic Expression Grammar\"\n\nexpression = term ( ( \"+\" | \"-\" ) term )* ;\nterm = factor ( ( \"*\" | \"/\" ) factor )* ;\nfactor = number | \"(\" expression \")\" ;\nnumber = digit+ ;\ndigit = \"0\" | \"1\" | \"2\" ;\n"
---
                         ┌─────────────────────┐
               ┌──────┐  │   ╭───╮    ┌──────┐ │
expression = ●─┤ term ├──┼─┬─┤ + ├─┬──┤ term ├─┼─●
               └──────┘  │ │ ╰───╯ │  └──────┘ │
                         │ │ ╭───╮ │           │
                         │ └─┤ - ├─┘           │
                         │   ╰───╯             │
                         └──────────◄──────────┘

                     ┌───────────────────────┐
         ┌────────┐  │   ╭───╮    ┌────────┐ │
term = ●─┤ factor ├──┼─┬─┤ * ├─┬──┤ factor ├─┼─●
         └────────┘  │ │ ╰───╯ │  └────────┘ │
                     │ │ ╭───╮ │             │
                     │ └─┤ / ├─┘             │
                     │   ╰───╯               │
                     └───────────◄───────────┘

             ┌────────┐
factor = ●─┬─┤ number ├───────────────────┬─●
           │ └────────┘                   │
           │ ╭───╮  ┌────────────┐  ╭───╮ │
           └─┤ ( ├──┤ expression ├──┤ ) ├─┘
             ╰───╯  └────────────┘  ╰───╯

             ┌───────┐
number = ●─┬─┤ digit ├─┬─●
           │ └───────┘ │
           └─────◄─────┘

            ╭───╮
digit = ●─┬─┤ 0 ├─┬─●
          │ ╰───╯ │
          │ ╭───╮ │
          ├─┤ 1 ├─┤
          │ ╰───╯ │
          │ ╭───╮ │
          └─┤ 2 ├─┘
            ╰───╯
