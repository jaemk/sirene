---
source: crates/sirene-core/tests/railroad.rs
expression: "railroad-peg-beta\ntitle \"Calculator Grammar\"\n\nExpression <- Term ((\"+\" / \"-\") Term)* ;\nTerm <- Factor ((\"*\" / \"/\") Factor)* ;\nFactor <- Number / \"(\" Expression \")\" ;\nNumber <- Digit+ ;\n"
---
                         ┌─────────────────────┐
               ┌──────┐  │   ╭───╮    ┌──────┐ │
Expression = ●─┤ Term ├──┼─┬─┤ + ├─┬──┤ Term ├─┼─●
               └──────┘  │ │ ╰───╯ │  └──────┘ │
                         │ │ ╭───╮ │           │
                         │ └─┤ - ├─┘           │
                         │   ╰───╯             │
                         └──────────◄──────────┘

                     ┌───────────────────────┐
         ┌────────┐  │   ╭───╮    ┌────────┐ │
Term = ●─┤ Factor ├──┼─┬─┤ * ├─┬──┤ Factor ├─┼─●
         └────────┘  │ │ ╰───╯ │  └────────┘ │
                     │ │ ╭───╮ │             │
                     │ └─┤ / ├─┘             │
                     │   ╰───╯               │
                     └───────────◄───────────┘

             ┌────────┐
Factor = ●─┬─┤ Number ├───────────────────┬─●
           │ └────────┘                   │
           │ ╭───╮  ┌────────────┐  ╭───╮ │
           └─┤ ( ├──┤ Expression ├──┤ ) ├─┘
             ╰───╯  └────────────┘  ╰───╯

             ┌───────┐
Number = ●─┬─┤ Digit ├─┬─●
           │ └───────┘ │
           └─────◄─────┘
