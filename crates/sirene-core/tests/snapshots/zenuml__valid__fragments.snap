---
source: crates/sirene-core/tests/zenuml.rs
expression: "zenuml\n    @Starter(Client)\n    API.book() {\n        try {\n            if(available) {\n                Booking.reserve()\n            } else if(waitlist) {\n                Booking.queue()\n            } else {\n                return none\n            }\n            while(retries < 3) {\n                Booking.confirm()\n            }\n            opt {\n                API->Mail: send receipt\n            }\n            par {\n                API->Log: booked\n                API->Metrics: booked\n            }\n        } catch(Timeout) {\n            API->Client: failed\n        } finally {\n            Booking.release()\n        }\n    }\n"
---

