gantt
    dateFormat YYYY-MM-DD
    tickInterval 1year
    weekday funday
    weekend sunday
    First  : 3d
    A      : a, 2014-01-01, 2d
    B      : a, 2014-01-03, 2d
    C      : after nope, 2d
    D      : 2014-13-01, 2d
    E      : 2014-01-01, soon
    F      : done
    G      : x, y, z, w
    H      : h, after i, 1d
    I      : i, after h, 1d
    click a href "https://example.com"
    stray words
