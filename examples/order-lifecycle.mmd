    %% Edge kinds: solid, thick, dotted, invisible, and arrowheads.
    cart[Cart] --> placed[Placed]
    placed ==>|paid| paid[Paid]
    placed -. timeout .-> cancelled[Cancelled]
    paid --> packed[Packed] --> shipped[Shipped]
